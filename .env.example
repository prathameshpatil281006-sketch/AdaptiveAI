# AdaptiveAI environment configuration reference (Step 72, I-22).
#
# Every application environment variable currently supported, with its
# built-in default. ALL variables are OPTIONAL; unset variables fall
# back to the defaults shown below and the app runs as-is.
#
# Loading behavior (unchanged): the application reads these from the
# PROCESS ENVIRONMENT via os.getenv/os.environ at import/call time.
# The app itself performs no .env auto-loading, so to apply this file
# locally either export the values in your shell or run processes via
# python-dotenv tooling (already a project dependency), e.g.:
#   dotenv run -- python run.py
#   dotenv run -- uvicorn app.api.main:app --host 127.0.0.1 --port 8000
# Copy this file to `.env` (git-ignored) and adjust as needed. Do not
# commit secrets or machine-specific absolute paths.

# --- FastAPI service (app/api/main.py) ---

# Legacy fallback model artifact name, used ONLY when no production
# serving reference (models/house_price/production.json) exists.
# Optional. Default: LinearRegression
HOUSE_PRICE_MODEL_NAME=LinearRegression

# Override for the House Price models directory (production reference
# + artifacts). Optional. Unset by default, which resolves to
# <project-root>/models/house_price. Leave commented unless overriding.
# Example (relative to the project root): models/house_price
# HOUSE_PRICE_MODELS_DIR=models/house_price

# --- Streamlit dashboard client (dashboard/api_client.py) ---

# Base URL of the FastAPI service used by the dashboard.
# Optional. Default: http://127.0.0.1:8000
ADAPTIVE_AI_API_URL=http://127.0.0.1:8000
